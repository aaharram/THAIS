<?xml version="1.0" encoding="utf-8"?>
<!--
  Application monopage (React Router) hébergée sur IIS : un rafraîchissement (Ctrl+R) ou un lien direct sur
  /adminlogin, /patrimoine/actifs... demande à IIS un fichier qui n'existe pas -> « 404 - Fichier ou répertoire
  introuvable ». Ici, une 404 générée par IIS (chemin inexistant) renvoie index.html ; les réponses 404 produites
  par l'API (existingResponse="PassThrough") restent intactes. Ne nécessite PAS le module « URL Rewrite ».
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" subStatusCode="-1" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
